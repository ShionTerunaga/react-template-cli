{
    "name": "next-pages-stylex",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "lint": "oxlint . --ignore-path .gitignore",
        "lint:fix": "oxlint . --fix --ignore-path .gitignore",
        "format": "oxfmt --write .",
        "format:check": "oxfmt --check .",
        "typecheck": "tsc --noEmit",
        "storybook": "storybook dev -p 6006",
        "build-storybook": "storybook build",
        "test": "vitest run",
        "test:cv": "vitest --coverage"
    },
    "dependencies": {
        "@stylexjs/stylex": "^0.19.1",
        "@testing-library/react": "^16.3.0",
        "@vitejs/plugin-react": "^6.0.3",
        "csstype": "^3.1.3",
        "motion": "^12.23.24",
        "next": "16.4.6",
        "react": "19.3.0",
        "react-dom": "19.3.0",
        "ts-utility-kit": "2.1.0",
        "valibot": "^1.3.1",
        "vite-tsconfig-paths": "^5.1.4",
        "vitest": "^5.0.0"
    },
    "devDependencies": {
        "@storybook/nextjs": "^10.3.5",
        "@stylexjs/babel-plugin": "^0.19.1",
        "@stylexjs/postcss-plugin": "^0.19.1",
        "@stylexjs/unplugin": "^0.19.1",
        "@types/node": "^26.5.0",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitest/coverage-v8": "^5.0.0",
        "autoprefixer": "^10.4.21",
        "babel-plugin-react-compiler": "1.0.0",
        "jsdom": "^27.0.1",
        "oxfmt": "^0.53.0",
        "oxlint": "^1.29.0",
        "oxlint-tsgolint": "^7.0.0",
        "storybook": "^10.6.2",
        "typescript": "^7.0.2"
    }
}
